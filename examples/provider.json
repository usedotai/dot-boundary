{
  "port": 8788,
  "providers": {
    "primary": { "baseURL": "https://your-provider.example/v1", "model": "your-model", "apiKeyEnv": "PROVIDER_API_KEY" },
    "backup": { "baseURL": "https://your-backup.example/v1", "model": "your-model", "apiKeyEnv": "BACKUP_API_KEY" }
  },
  "routes": {
    "primary-only": { "destinations": ["primary", "backup"], "allow": ["primary"] },
    "approved-failover": { "destinations": ["primary", "backup"], "allow": ["primary", "backup"] }
  }
}
